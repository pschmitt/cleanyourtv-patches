+    /**
+     * A short weather line ("12° Cloudy") that something else on the network writes with
+     * {@code settings put global tvhome_weather "..."}; this build has no network permission. The optional
+     * tvhome_weather_at (epoch seconds) hides a line older than three hours, so a silent writer does not leave
+     * stale weather on Home. Empty when nothing is set.
+     */
+    private String weatherText() {
+        try {
+            String text = Settings.Global.getString(getContentResolver(), "tvhome_weather");
+            if (text == null || text.trim().isEmpty()) return "";
+            String at = Settings.Global.getString(getContentResolver(), "tvhome_weather_at");
+            if (at != null && !at.isEmpty()
+                    && System.currentTimeMillis() / 1000 - Long.parseLong(at.trim()) > 3 * 3600) return "";
+            return text.trim();
+        } catch (RuntimeException e) {
+            return "";
+        }
+    }
